# Copie para .env e preencha.

# Chave da API do Gemini (https://aistudio.google.com/apikey)
# Sem ela, a categorização usa o motor de regras local.
GEMINI_API_KEY=""

# Opcional: porta do servidor (padrão 3000)
# PORT=3000

# Recomendado em servidor público: chave que o app precisa enviar para usar a IA.
# Gere um texto longo e aleatório e cole o mesmo valor em Backup e vínculos → Categorização.
# RETROFIN_API_KEY=""

# Opcional: modelo do Gemini
# GEMINI_MODEL="gemini-3.8-flash"
